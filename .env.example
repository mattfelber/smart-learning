LLM_PROVIDER=gemini
GEMINI_API_KEY=your-key-here

# Preferred model. Tried first on every turn.
GEMINI_MODEL=gemini-3.8-flash

# Fallback chain, tried in order when a model is out of quota, busy or retired.
# The free tier meters requests per model per day, so each extra entry adds
# daily headroom. The flash models teach better but have a very small daily
# allowance; the flash-lite models are weaker but allow far more requests, which
# is why they sit at the end as a safety net.
# Leave unset to use the built-in chain.
GEMINI_FALLBACKS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite

PORT=3001
CLIENT_PORT=5173
